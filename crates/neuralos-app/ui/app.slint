import { Button, Slider, ScrollView, VerticalBox, HorizontalBox } from "std-widgets.slint";

export component App inherits Window {
    title: "NeuralOS — SNN Visualizer";
    preferred-width: 900px;
    preferred-height: 640px;
    background: #0E0E1A;

    // Sim controls (Rust reads/writes these).
    in-out property <bool> running;
    in-out property <bool> learning;
    in-out property <float> input-drive;  // μA, 0..=1000 (float for the Slider)
    in property <image> raster;
    in property <image> weight-map;
    in property <string> stats-text;
    in property <string> header-text;
    callback run-clicked();
    callback step-clicked();
    callback learn-clicked();
    callback drive-edited(float);

    VerticalBox {
        // Top control bar.
        HorizontalBox {
            spacing: 10px;
            Button {
                text: root.running ? "⏸ Pause" : "▶ Run";
                clicked => { root.run-clicked(); }
            }
            Button {
                text: "⏭ Step";
                clicked => { root.step-clicked(); }
            }
            Button {
                text: root.learning ? "🧠 Learn: on" : "🧠 Learn: off";
                clicked => { root.learn-clicked(); }
            }
            Text {
                text: "Drive: " + root.input-drive + " μA";
                color: #CCCCCC;
                vertical-alignment: center;
            }
            Slider {
                minimum: 0;
                maximum: 1000;
                value <=> root.input-drive;
                width: 220px;
                changed => { root.drive-edited(self.value); }
            }
            Text {
                text: root.header-text;
                color: #888888;
                vertical-alignment: center;
                horizontal-alignment: right;
            }
        }

        // Spike raster (left) + weight matrix (right): watch it fire AND learn.
        HorizontalBox {
            spacing: 6px;
            vertical-stretch: 1;

            // Spike raster. The SharedPixelBuffer (RASTER_COLS × N) is scaled to fit.
            Rectangle {
                background: #050508;
                horizontal-stretch: 1;
                Image {
                    width: 100%;
                    height: 100%;
                    image-fit: contain;
                    source: root.raster;
                }
            }

            // Synaptic weight matrix (N × N). Excitatory = orange, inhibitory = cyan,
            // brightness ∝ |weight|. STDP drift shows as live color shifts.
            Rectangle {
                background: #050508;
                horizontal-stretch: 1;
                Image {
                    width: 100%;
                    height: 100%;
                    image-fit: contain;
                    source: root.weight-map;
                }
            }
        }

        // Status bar.
        Text {
            text: root.stats-text;
            color: #AAAAAA;
            font-size: 12px;
        }
    }
}
