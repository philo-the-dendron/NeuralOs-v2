import { Button, LineEdit, ListView, VerticalBox, HorizontalBox } from "std-widgets.slint";

// A single result row, exposed to Rust as the generated `TitleRow` struct.
export struct TitleRow {
    title: string,
    abs-url: string,
}

export component App inherits Window {
    title: "NeuralOS";
    preferred-width: 900px;
    preferred-height: 640px;
    background: white;

    // Edited by the user in the LineEdit, read by Rust on search.
    in-out property <string> search-query;
    // Set by Rust from a worker thread, rendered by the ListView below.
    in property <[TitleRow]> results;
    // Fired by the Search button; Rust registers a handler that runs the fetch.
    callback search-clicked();

    VerticalBox {
        HorizontalBox {
            spacing: 8px;
            LineEdit {
                placeholder-text: "Search arXiv (e.g. \"spiking neural network\")...";
                text <=> root.search-query;
            }
            Button {
                text: "Search";
                clicked => { root.search-clicked(); }
            }
        }

        ListView {
            for row[i] in root.results : Rectangle {
                height: 56px;
                background: white;
                HorizontalBox {
                    spacing: 8px;
                    Text {
                        text: row.title;
                        wrap: word-wrap;
                        vertical-alignment: center;
                        overflow: elide;
                        color: black;
                    }
                }
            }
        }
    }
}
